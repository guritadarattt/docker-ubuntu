# ==========================================
# GURITA VPS - .gitignore
# ==========================================

# ---------- Docker ----------
# Docker build context & artifacts
*.tar
*.tar.gz
*.tgz
docker-compose.override.yml
docker-compose.*.local.yml
.docker/

# ---------- Environment & Secrets ----------
# Jangan pernah commit file ini!
.env
.env.*
!.env.example
*.env
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
authorized_keys
known_hosts

# ---------- Logs ----------
*.log
logs/
log/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Backup & Data ----------
*.bak
*.backup
*.old
*.orig
*.sql
*.sql.gz
*.dump
backup/
backups/
data/
volumes/

# ---------- OS Files ----------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ---------- Editor & IDE ----------
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.example.json

# JetBrains (IntelliJ, GoLand, PyCharm, dll)
.idea/
*.iml
*.ipr
*.iws
out/

# Vim
*.swp
*.swo
*.swn
.*.sw?
.vim/

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# Nano
*.save

# ---------- Node.js (jika ada tooling) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.cache/
.parcel-cache/
.npm/
.yarn/
coverage/
.nyc_output/

# ---------- Python (jika ada tooling) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# ---------- Temporary Files ----------
*.tmp
*.temp
tmp/
temp/
.cache/

# ---------- Supervisord / Runtime ----------
*.pid
*.sock
supervisord.log
supervisor.sock

# ---------- Local Testing ----------
test/
tests/
.local/
*.local
sandbox/
playground/

# ---------- CI/CD ----------
.github/workflows/*.local.yml
.gitlab-ci.local.yml
.circleci/local.yml

# ---------- Archives ----------
*.zip
*.rar
*.7z
!.gitkeep
